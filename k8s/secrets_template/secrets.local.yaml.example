# Prefer k8s/manifests/config/secrets.local.yaml.example — this copy is kept in sync.
apiVersion: v1
kind: Secret
metadata:
  name: sift-secrets
type: Opaque
stringData:
  DB_PASSWORD: your-db-password
  DATABASE_URL: postgres://postgres:your-db-password@postgres:5432/sift?sslmode=disable
  SESSION_SECRET: your-session-secret
  TOKEN_ENCRYPTION_KEY: replace-with-64-hex-chars
  WEBHOOK_SECRET: your-webhook-secret
  DISCORD_CLIENT_ID: your-discord-client-id
  DISCORD_CLIENT_SECRET: your-discord-client-secret
  DISCORD_BOT_TOKEN: your-discord-bot-token
  GOOGLE_CLIENT_ID: your-google-client-id.apps.googleusercontent.com
  GOOGLE_CLIENT_SECRET: your-google-client-secret
  GOOGLE_PUBSUB_TOPIC: projects/YOUR_GCP_PROJECT/topics/YOUR_TOPIC
