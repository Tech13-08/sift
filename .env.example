# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env.

# --- Postgres (used by docker compose) ---
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=sift

# Used only if you run a service on the host instead of Compose.
# Compose builds DATABASE_URL from DB_* above.
DATABASE_URL=postgres://postgres:password@localhost:5432/sift?sslmode=disable

# --- Auth session ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# AES-256-GCM for oauth_credentials access/refresh tokens. 64 hex chars.
# Losing this key means every Gmail inbox must be relinked.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars
# PORT=3000

# --- Discord OAuth ---
# https://discord.com/developers/applications
# Redirect: http://localhost:3000/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Bot DMs: mute / always show / jobs / rules. Enable Message Content Intent if DMs look empty.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Used in dead-Gmail Discord DMs.
# AUTH_PUBLIC_URL=http://localhost:3000

# --- Google OAuth + Gmail API ---
# https://console.cloud.google.com/apis/credentials
# Enable Gmail API. Redirect: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Optional. Unused by the services; Pub/Sub uses GOOGLE_PUBSUB_TOPIC.
# GOOGLE_PROJECT_ID=

# Pub/Sub topic that Gmail users.watch publishes to.
# Format: projects/YOUR_GCP_PROJECT/topics/YOUR_TOPIC
GOOGLE_PUBSUB_TOPIC=projects/YOUR_GCP_PROJECT/topics/YOUR_TOPIC

# --- Ingestion webhook ---
# Host port published by Compose (left side of HOST:CONTAINER).
# The process inside the container still listens on 8080.
# Change this if something else already uses 8080 (e.g. stardew-server).
# Compose Hookdeck talks to ingestion on the Docker network, not this host port.
INGESTION_HOST_PORT=8082
# If set, POST /webhooks/gmail requires header X-Webhook-Secret.
# Leave empty only for a locked-down local machine.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# --- Hookdeck (Compose keeps listen running) ---
# Optional. If unset, the hookdeck container uses ~/.config/hookdeck from the host.
# A project API key from the Hookdeck dashboard also works.
HOOKDECK_API_KEY=
HOOKDECK_SOURCE=sift-webhook

# --- Optional service overrides ---
# HOST=0.0.0.0
# PORT=3000
# REDIS_ADDR=localhost:6379
# SUMMARIZER_HEALTH_PORT=8090
# Local only. POST /test-digest and /test-recent DM a preview; they do not mark mail digested.
# DIGEST_TEST_ENDPOINT=1
# Ollama on the host. Compose uses host.docker.internal.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# NODE_ENV=development
# WATCH_RENEW_BEFORE_MS=86400000
