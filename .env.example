# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env.

# --- Postgres (used by docker compose) ---
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=sift

# Used only if you run a service on the host instead of Compose.
# Compose builds DATABASE_URL from DB_* above.
DATABASE_URL=postgres://postgres:password@localhost:5432/sift?sslmode=disable

# --- Auth session ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# AES-256-GCM for oauth_credentials access/refresh tokens. 64 hex chars.
# Losing this key means every Gmail inbox must be relinked.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars
# PORT=3000
# Web UI (Compose host port WEB_HOST_PORT, default 3010). Prefer the public HTTPS URL when tunneled.
WEB_URL=https://sift.falaktulsi.com
AUTH_PUBLIC_URL=https://sift.falaktulsi.com
# WEB_HOST_PORT=3010
# Cloudflare tunnel token (Zero Trust → Tunnels → your tunnel → token). Never commit the real value.
# CF_TUNNEL_TOKEN=

# --- Discord OAuth ---
# https://discord.com/developers/applications
# Redirect via web proxy: https://sift.falaktulsi.com/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Bot DMs: mute / always show / jobs / rules. Enable Message Content Intent if DMs look empty.
DISCORD_REDIRECT_URI=https://sift.falaktulsi.com/auth/discord/callback
# Shown when linking Discord so users share a server with the bot (needed for DMs).
DISCORD_SERVER_INVITE=https://discord.gg/sDzA28WcjP
# Optional override. Defaults to an OAuth invite built from DISCORD_CLIENT_ID.
# DISCORD_BOT_INVITE=https://discord.com/oauth2/authorize?client_id=...&permissions=0&integration_type=0&scope=applications.commands+bot

# --- Google OAuth + Gmail API ---
# https://console.cloud.google.com/apis/credentials
# Enable Gmail API. Redirect: https://sift.falaktulsi.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sift.falaktulsi.com/auth/google/callback
# Optional. Unused by the services; Pub/Sub uses GOOGLE_PUBSUB_TOPIC.
# GOOGLE_PROJECT_ID=

# Pub/Sub topic that Gmail users.watch publishes to.
# Format: projects/YOUR_GCP_PROJECT/topics/YOUR_TOPIC
GOOGLE_PUBSUB_TOPIC=projects/YOUR_GCP_PROJECT/topics/YOUR_TOPIC

# --- Ingestion webhook ---
# Host port published by Compose (left side of HOST:CONTAINER).
# The process inside the container still listens on 8080.
# Change this if something else already uses 8080 (e.g. stardew-server).
# Compose Hookdeck talks to ingestion on the Docker network, not this host port.
INGESTION_HOST_PORT=8082
# If set, POST /webhooks/gmail requires header X-Webhook-Secret OR ?token=.
# Prod Pub/Sub push uses ?token= (cannot set custom headers).
# Leave empty only for a locked-down local machine.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# --- Hookdeck (legacy local testing without a public domain) ---
# Prod uses Pub/Sub → https://YOUR_HOST/webhooks/gmail?token=… (make pubsub-point-at-public).
# Hookdeck was the early laptop relay (hkdk.events → Compose ingestion).
# HOOKDECK_API_KEY=
# HOOKDECK_SOURCE=sift-webhook

# --- Grafana (make install-monitoring) ---
# Admin login at https://grafana-sift.falaktulsi.com/login (public visitors use anonymous Viewer).
# Generate with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# --- Optional service overrides ---
# HOST=0.0.0.0
# PORT=3000
# REDIS_ADDR=localhost:6379
# SUMMARIZER_HEALTH_PORT=8090
# Local only. POST /test-digest and /test-recent DM a preview; they do not mark mail digested.
# DIGEST_TEST_ENDPOINT=1
# Cap messages classified per digest window (default 400).
# DIGEST_MAX_MESSAGES=400
# Ollama on the host. Compose uses host.docker.internal; k3d uses host.docker.internal too.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Password-reset email (optional). Without SMTP, reset links are logged by auth-service.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Quote angle brackets so shells can source .env if needed:
# SMTP_FROM="Sift <noreply@yourdomain.com>"
# NODE_ENV=development
# WATCH_RENEW_BEFORE_MS=86400000
